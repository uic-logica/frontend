                        {
                          "type": "frame",
                          "id": "P8vGc",
                          "name": "Section · How we use it",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 12,
                          "children": [
                            {
                              "type": "frame",
                              "id": "r1AkCD",
                              "name": "Head",
                              "gap": 12,
                              "alignItems": "center",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "Cf961",
                                  "name": "N",
                                  "fill": "$d-accent-text",
                                  "content": "04",
                                  "fontFamily": "$d-font",
                                  "fontSize": 13,
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "FXtbB",
                                  "name": "H",
                                  "fill": "$d-text",
                                  "content": "How we use it",
                                  "fontFamily": "$d-font-serif",
                                  "fontSize": 26,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "f6Md7",
                              "name": "P",
                              "fill": "$d-text-2",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "To run the org: process membership and event sign-ups, communicate about events and opportunities, coordinate with speakers and partners, and keep the member directory accurate. We don't use your information for anything beyond that.",
                              "lineHeight": 1.65,
                              "fontFamily": "$d-font",
                              "fontSize": 17,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "IEdM1",
                          "name": "Section · Sharing",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 12,
                          "children": [
                            {
                              "type": "frame",
                              "id": "nYnG8",
                              "name": "Head",
                              "gap": 12,
                              "alignItems": "center",
