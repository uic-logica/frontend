                                  "name": "N",
                                  "fill": "$d-accent-text",
                                  "content": "05",
                                  "fontFamily": "$d-font",
                                  "fontSize": 13,
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "SaKb2",
                                  "name": "H",
                                  "fill": "$d-text",
                                  "content": "Sharing",
                                  "fontFamily": "$d-font-serif",
                                  "fontSize": 26,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "rZGfw",
                              "name": "P",
                              "fill": "$d-text-2",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "We don't sell your information. We share it only when it's the point of the feature you used (for example, sharing your resume with a company visiting for a recruiting event, only if you opted into that) or when required by law.",
                              "lineHeight": 1.65,
                              "fontFamily": "$d-font",
                              "fontSize": 17,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "rc7zZ",
                          "name": "Section · How long we keep it",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 12,
                          "children": [
                            {
                              "type": "frame",
                              "id": "GHrum",
                              "name": "Head",
                              "gap": 12,
