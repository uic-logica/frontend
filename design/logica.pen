                                  "type": "text",
                                  "id": "TTgY1",
                                  "name": "N",
                                  "fill": "$d-accent-text",
                                  "content": "05",
                                  "fontFamily": "$d-font",
                                  "fontSize": 13,
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "QmqM4",
                                  "name": "H",
                                  "fill": "$d-text",
                                  "content": "Sharing",
                                  "fontFamily": "$d-font-serif",
                                  "fontSize": 26,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "LprAZ",
                              "name": "P",
                              "fill": "$d-text-2",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "We don't sell your information. We share it only when it's the point of the feature you used (for example, sharing your resume with a company visiting for a recruiting event, only if you opted into that) or when required by law.",
                              "lineHeight": 1.65,
                              "fontFamily": "$d-font",
                              "fontSize": 17,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "C42Py5",
                          "name": "Section · How long we keep it",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 12,
                          "children": [
                            {
                              "type": "frame",
                              "id": "FMWNZ",
                              "name": "Head",
                              "gap": 12,
                              "alignItems": "center",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "fOBGP",
                                  "name": "N",
                                  "fill": "$d-accent-text",
                                  "content": "06",
                                  "fontFamily": "$d-font",
                                  "fontSize": 13,
                                  "fontWeight": "600"
                                },
                                {
                                  "type": "text",
                                  "id": "VFVk1",
                                  "name": "H",
                                  "fill": "$d-text",
                                  "content": "How long we keep it",
                                  "fontFamily": "$d-font-serif",
                                  "fontSize": 26,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "eWxhj",
                              "name": "P",
                              "fill": "$d-text-2",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "We keep your information for as long as your account is active plus a reasonable period after, so returning members don't have to start over. You can ask us to delete your account and associated data at any time.",
                              "lineHeight": 1.65,
                              "fontFamily": "$d-font",
                              "fontSize": 17,
                              "fontWeight": "normal"
                            }
                          ]
                        },
