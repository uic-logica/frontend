                              "type": "text",
                              "id": "y6hqC",
                              "name": "P",
                              "fill": "$d-text-2",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Signing in sets a single first-party session cookie so the site knows you're signed in. We don't run third-party analytics, ad trackers, or marketing pixels on this site.",
