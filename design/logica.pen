                              "name": "P",
                              "fill": "$d-text-2",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "LOGICA @ UIC (“LOGICA,” “we,” “us”) is a student organization at the University of Illinois Chicago. This policy covers the information this website collects and how we handle it. It doesn't cover UIC's own systems, or any third-party site we link to.",
                              "lineHeight": 1.65,
