              "id": "Tl7nk",
              "name": "Statement",
              "fill": "$on-ink",
              "textGrowth": "fixed-width",
              "width": 1020,
              "content": "Camaraderie and growth — not only as an individual, but as a community.",
              "lineHeight": 1,
