              "name": "Goals",
              "width": "fill_container",
              "gap": 32,
              "children": [
                {
                  "type": "frame",
                  "id": "L1U3M",
                  "name": "Goal Get people in the room",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 10,
                  "children": [
                    {
                      "type": "text",
                      "id": "HxarK",
                      "name": "Title",
                      "fill": "$on-ink",
                      "content": "Diversity",
                      "lineHeight": 1.3,
                      "fontFamily": "$font-sans",
                      "fontSize": "$t-h4",
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "d8iasM",
                      "name": "Body",
                      "fill": "$on-ink-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Latinx and underrepresented students in computing, and anyone who shares that goal. You do not have to be Latinx to join. Weekly meetings in SEO, no experience bar.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-sans",
                      "fontSize": "$t-body-sm",
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "xPHWU",
                  "name": "Goal Get people ready",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 10,
                  "children": [
                    {
                      "type": "text",
                      "id": "mfowZ",
                      "name": "Title",
                      "fill": "$on-ink",
                      "content": "Growth and development",
                      "lineHeight": 1.3,
                      "fontFamily": "$font-sans",
                      "fontSize": "$t-h4",
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "ssk5U",
                      "name": "Body",
                      "fill": "$on-ink-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Technical, leadership and professional skills. Company visits, guest speakers and tech talks, peer mentoring, resume reads and mock interviews.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-sans",
                      "fontSize": "$t-body-sm",
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "ESE9g",
                  "name": "Goal Get people building",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 10,
                  "children": [
                    {
                      "type": "text",
                      "id": "S0fNed",
                      "name": "Title",
                      "fill": "$on-ink",
                      "content": "Community",
                      "lineHeight": 1.3,
                      "fontFamily": "$font-sans",
                      "fontSize": "$t-h4",
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "UlEk5",
                      "name": "Body",
                      "fill": "$on-ink-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Project teams, volunteering, and events with CS professors. First-years sit next to seniors, and nobody is quizzed at the door.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-sans",
                      "fontSize": "$t-body-sm",
                      "fontWeight": "normal"
                    }
                  ]
                }
