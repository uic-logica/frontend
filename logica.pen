                    },
                    {
                      "type": "text",
                      "id": "s4jkO",
                      "name": "t",
                      "fill": "$ink-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Latine students, faculty and staff demand a dedicated space at UIC. The Rafael Cintrón Ortiz Latino Cultural Center is founded, named for a Puerto Rican professor who backed it.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-sans",
                      "fontSize": "$t-body-sm",
                      "fontWeight": "normal"
