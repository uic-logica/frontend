                      "content": "Now",
                      "lineHeight": 1,
                      "fontFamily": "$font-display",
                      "fontSize": "$t-h2",
                      "fontWeight": "800"
                    },
                    {
                      "type": "text",
                      "id": "WmA2f",
                      "name": "t",
                      "fill": "$ink-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "LOGICA is one of the Center's affiliated organizations, and sits in the College of Engineering. Same demand, fifty years on: a room where Latinx students in computing are not the only one.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-sans",
                      "fontSize": "$t-body-sm",
