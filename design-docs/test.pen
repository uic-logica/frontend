      {
       "id": "hero-asset-note-332",
       "type": "note",
       "name": "Hero asset note",
       "content": "The lit object here is VECTOR STAGING, not the shipping asset. It fixes position, crop, scale, lighting direction and material palette only. Production: a pre-rendered still (plus an optional short compressed loop) baked from a real 3D build, per design.md. A live WebGL scene would not hold LCP < 2.5s on mid-range mobile. Reduced motion falls back to the static finished frame.",
       "x": 64,
       "y": 780,
       "width": 520,
       "fontFamily": "$fontBody",
       "fontSize": 12
      },
      {
       "id": "hero-primary-action-333",
       "type": "note",
       "name": "Hero primary action",
       "content": "mockup.md leaves the hero's single door to the board: Sign In, or into Upcoming Events. Shown here as Upcoming Events, because Sign In already sits in the header and the calendar is the lower-friction door for a first-time visitor. Swap if the board disagrees.",
       "x": 624,
       "y": 780,
       "fontFamily": "$fontBody",
       "fontSize": 12,
       "width": 320
      }
     ]
    },
